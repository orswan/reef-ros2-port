<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reef_sim</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic X3 quadrotor scenario that produces ROS 2 ground truth,
    IMU, and idealized downward range data (with rosbag2 recording and
    analysis) for porting the REEF estimator.
  </description>
  <maintainer email="orswan@stanford.edu">orswan</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>reef_estimator</exec_depend>
  <exec_depend>reef_msgs</exec_depend>
  <exec_depend>reef_x3_adapter</exec_depend>
  <exec_depend>reef_control</exec_depend>
  <exec_depend>reef_fc_standin</exec_depend>
  <exec_depend>rosflight_msgs</exec_depend>
  <exec_depend>actuator_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

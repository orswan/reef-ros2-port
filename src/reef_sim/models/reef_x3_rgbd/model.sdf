<?xml version="1.0"?>
<!--
  reef_x3_rgbd: GENERATED from reef_x3/model.sdf by scripts/make_vision_assets.py
  (P08): the same vehicle plus a forward-looking RGB-D camera.

  reef_x3: X3 quadrotor for REEF estimator data generation.

  Derived from "X3 UAV" v4 model.sdf by Open Robotics (Carlos Aguero, Cole
  Biesemeyer), Gazebo Fuel, CC BY 4.0
  (http://creativecommons.org/licenses/by/4.0/). Upstream file sha256:
  b76c085236760a42d888a7208bd1b7c6c4c5ea7bd25c344672cce54965defcf0
  (see src/reef_sim/assets/x3_uav_v4.json).

  Changes from upstream:
    * model renamed reef_x3 (the world includes it as "x3");
    * noise-free IMU sensor "imu" added to X3/base_link (at its origin, axes
      aligned); noise is added in ROS by reef_sim/imu_noise.py.
  Meshes are still loaded from the pinned upstream asset (model://x3/...),
  installed by scripts/setup_assets.py.
-->
<sdf version='1.6'>
  <model name='reef_x3_rgbd'>
    <pose>0 0 0.053302 0 0 0</pose>
    <link name='X3/base_link'>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <inertial>
        <pose frame=''>0 0 0 0 -0 0</pose>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0347563</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.07</iyy>
          <iyz>0</iyz>
          <izz>0.0977</izz>
        </inertia>
      </inertial>
      <collision name='X3/base_link_inertia_collision'>
        <pose frame=''>0 0 0 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.47 0.47 0.11</size>
          </box>
        </geometry>
      </collision>
      <visual name='X3/base_link_inertia_visual'>
        <pose frame=''>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x3/meshes/x3.dae</uri>
          </mesh>
        </geometry>
      </visual>
          <!-- IMU (added). Reports specific force and angular rate in this link's
           frame (FLU), NOISE-FREE; reef_sim's imu_noise node adds seeded noise
           and publishes /x3/imu. (Gazebo's own sensor noise draws from a global
           generator that several systems use concurrently, so it cannot be made
           reproducible with a seed.) Orientation output is disabled: attitude
           would be simulation truth, not a measurement. -->
      <sensor name='imu' type='imu'>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <topic>/reef/x3/imu_noise_free</topic>
        <gz_frame_id>x3/base_link</gz_frame_id>
        <imu>
          <enable_orientation>0</enable_orientation>
        </imu>
      </sensor>
      <!-- RGB-D camera (P08, GENERATED by scripts/make_vision_assets.py): forward-looking, at the
           legacy kiwi position (FRD 0.1355 0.0175 -0.0455 m = FLU 0.1355 -0.0175 0.0455 m), ideal
           orientation (Gazebo camera x = body forward). Converter extrinsics: body_to_camera_quat
           (0.5, -0.5, 0.5, -0.5), body_to_camera_trans (0.1354765750332004, 0.0175314092839309, -0.0455417178618858). -->
      <sensor name='rgbd' type='rgbd_camera'>
        <pose>0.1354765750332004 -0.0175314092839309 0.0455417178618858 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>/reef/x3/rgbd</topic>
        <gz_frame_id>x3/camera_optical</gz_frame_id>
        <camera>
          <horizontal_fov>1.0471975511965976</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.3</near><far>8.0</far></clip>
          <depth_camera><clip><near>0.3</near><far>8.0</far></clip></depth_camera>
        </camera>
      </sensor>
    </link>
    <link name='X3/rotor_0'>
      <pose frame=''>0.13 -0.22 0.023 0 -0 0</pose>
      <inertial>
        <pose frame=''>0 0 0 0 -0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <collision name='X3/rotor_0_collision'>
        <pose frame=''>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='X3/rotor_0_visual'>
        <pose frame=''>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.1 0.1 0.1</scale>
            <uri>model://x3/meshes/propeller_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Blue</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
    </link>
    <joint name='X3/rotor_0_joint' type='revolute'>
      <child>X3/rotor_0</child>
      <parent>X3/base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <link name='X3/rotor_1'>
      <pose frame=''>-0.13 0.2 0.023 0 -0 0</pose>

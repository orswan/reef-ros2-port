<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reef_fc_standin</name>
  <version>0.1.0</version>
  <description>
    SIMPLIFIED LOW-LEVEL STAND-IN (development tool) for the closed-loop
    simulation (P07): firmware-style command mux, attitude loop on truth
    attitude, and motor allocation for Gazebo's MulticopterMotorModel.
    Not ROSflight; not flight-representative.
  </description>
  <maintainer email="orswan@stanford.edu">orswan</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <depend>eigen</depend>
  <depend>reef_control</depend>
  <depend>rclcpp</depend>
  <depend>actuator_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosflight_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

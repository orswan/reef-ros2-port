# Second compose instance for the H11 fresh-image reproduction (P09). Use it
# only from a SEPARATE clone (README "Reproducing the release"). It shares no
# image tag, container, port, or volume with the working dev container
# (reef_ros2_dev, 127.0.0.1:8081, reef_ros2_gz) or with ros2_novnc_container.
REEF_COMPOSE_PROJECT=reef_h11
REEF_IMAGE=reef_ros2_h11:jazzy
REEF_CONTAINER=reef_ros2_h11
REEF_VNC_PORT=8082
REEF_GZ_VOLUME=reef_ros2_h11_gz
